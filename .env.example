# TOSSConf 2026 — QR Scanner environment variables
# Copy this to .env and customise before running docker compose

# ── Django ─────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=tossconf26-change-this-to-a-real-secret-key-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ── PostgreSQL ──────────────────────────────────────────────────────────────────
POSTGRES_DB=scanner_db
POSTGRES_USER=scanner_user
POSTGRES_PASSWORD=scanner_pass
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Tickets DB (read-only SQLite from pass generator, mounted as volume) ────────
TICKETS_DB_PATH=/tickets/tickets.db
